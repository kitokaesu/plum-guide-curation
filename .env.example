# Runtime database: the app reads Cloudflare D1 through the `DB` binding
# (provided by Wrangler locally and by Freebuff Sites when deployed). Nothing
# here points the app at SQLite at runtime.

# Used only by the Prisma CLI and the demo-data generator (prisma/seed.mjs).
DATABASE_URL="file:./dev.db"

# Signing secret for the session cookie — use a long random value.
# Local development may leave this unset and use the built-in fallback.
# In production set it as a platform secret (Sites -> Secrets), never in a
# NEXT_PUBLIC_* variable.
AUTH_SECRET="replace-with-a-long-random-string"
